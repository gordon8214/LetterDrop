{
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:wrangler": "node scripts/check-wrangler-bindings.mjs",
    "check:wrangler:template": "node scripts/check-wrangler-template.mjs",
    "smoke:deploy": "node scripts/predeploy-smoke.mjs",
    "deploy": "wrangler deploy --minify src/index.ts",
    "deploy:safe": "npm run check:wrangler && npm run smoke:deploy && npm run deploy"
  },
  "dependencies": {
    "hono": "^4.3.11",
    "mimetext": "^3.0.24",
    "postal-mime": "^2.2.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240403.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.67.0"
  }
}
